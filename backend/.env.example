# --- App ---
ENV=development
DEBUG=true

# --- Database ---
# Local dev default (SQLite, no setup needed):
DATABASE_URL=sqlite:///./wanderpath.db
# Production example (Postgres):
# DATABASE_URL=postgresql+psycopg2://wanderpath:changeme@localhost:5432/wanderpath

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Neshan (map + place data provider) ---
NESHAN_API_KEY=
NESHAN_MAP_BASE_URL=https://api.neshan.org/v4
NESHAN_PLACE_BASE_URL=https://api.neshan.org/v1
NESHAN_MAP_STYLE_URL=https://static.neshan.org/sdk/maplibre/styles/light.json

# --- Place/City cache ---
PLACE_CACHE_TTL_SECONDS=604800
ROUTE_CACHE_TTL_SECONDS=86400

# --- Device identity (guest fallback during auth transition) ---
DEVICE_ID_HEADER_NAME=X-Device-Id
DEVICE_ID_COOKIE_NAME=wanderpath_device_id
DEVICE_ID_COOKIE_TTL_DAYS=365

# --- Auth (Google sign-in + session JWT) ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
GOOGLE_CLIENT_ID=
# Local "ورود آزمایشی" button — keep true only in development
ALLOW_DEV_LOGIN=true
